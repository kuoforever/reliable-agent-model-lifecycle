{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fullcycle/gui-grounding-predictions-v1.schema.json",
  "title": "MM-002 GUI grounding predictions v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["gui_grounding_prediction_version", "suite_id", "producer", "records"],
  "properties": {
    "gui_grounding_prediction_version": {"const": 1},
    "suite_id": {"$ref": "#/$defs/identifier"},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "model_id", "model_revision"],
      "properties": {
        "kind": {"enum": ["synthetic_probe", "model"]},
        "model_id": {"$ref": "#/$defs/nullableString"},
        "model_revision": {"$ref": "#/$defs/nullableString"}
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/prediction"}
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"},
    "nullableString": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 2048}]},
    "nullableIdentifier": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/identifier"}]},
    "bbox": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 0, "maximum": 4096},
        {"type": "integer", "minimum": 0, "maximum": 4096},
        {"type": "integer", "minimum": 0, "maximum": 4096},
        {"type": "integer", "minimum": 0, "maximum": 4096}
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "nullableBbox": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/bbox"}]},
    "argumentValue": {"type": ["string", "number", "integer", "boolean", "null"]},
    "arguments": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {"$ref": "#/$defs/identifier"},
      "additionalProperties": {"$ref": "#/$defs/argumentValue"}
    },
    "prediction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "disposition", "tool", "arguments", "ref", "bbox", "reason"],
      "properties": {
        "case_id": {"$ref": "#/$defs/identifier"},
        "disposition": {"enum": ["act", "reject", "fallback"]},
        "tool": {"$ref": "#/$defs/nullableIdentifier"},
        "arguments": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/arguments"}]},
        "ref": {"$ref": "#/$defs/nullableIdentifier"},
        "bbox": {"$ref": "#/$defs/nullableBbox"},
        "reason": {"$ref": "#/$defs/nullableIdentifier"}
      }
    }
  }
}
